# Track source and documentation only. Keep media and backups on ORICO.
/*
!/.gitignore
!/README.md
!/app/
!/tools/
!/scripts/
!/docs/
/app/**
!/app/**/
!/app/**/*.js
!/app/**/*.css
!/app/**/*.html
!/app/**/*.json
!/app/**/*.txt
# the previews on the samples page (a few small ones are added every day; tools/make_sample_previews.mjs makes them)
!/app/guide/samples/*.jpg
!/app/guide/samples/*.mp4
/tools/**
!/tools/**/
!/tools/**/*.py
!/tools/**/*.mjs
!/tools/**/*.js
!/tools/**/*.html
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/*.json
!/docs/**/*.txt
!/app/_headers
**/.DS_Store
**/._*
**/__pycache__/
**/node_modules/
**/.env
**/.env.*
**/*.pem
**/*.key
/tools/out/
