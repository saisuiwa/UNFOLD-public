# Track source and documentation only. Keep media and backups on ORICO.
/*
!/.gitignore
!/README.md
!/app/
!/tools/
!/scripts/
!/docs/
/app/**
!/app/**/
!/app/**/*.js
!/app/**/*.css
!/app/**/*.html
!/app/**/*.json
!/app/**/*.txt
/tools/**
!/tools/**/
!/tools/**/*.py
!/tools/**/*.mjs
!/tools/**/*.js
!/tools/**/*.html
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/*.json
!/docs/**/*.txt
!/app/_headers
**/.DS_Store
**/._*
**/__pycache__/
**/node_modules/
**/.env
**/.env.*
**/*.pem
**/*.key
/tools/out/

# Bundled, redistributable font binaries used offline by Troika.
!/app/vendor/motion-fonts/*.ttf

/tools/code-motion-font-build/.venv/
/tools/code-motion-build/.deps/
