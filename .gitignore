# Track source and documentation only. Keep media and backups on ORICO.
/*
!/.gitignore
!/README.md
!/LICENSE
!/app/
!/tools/
!/scripts/
!/docs/
/app/**
!/app/**/
!/app/**/*.js
!/app/**/*.css
!/app/**/*.html
!/app/**/*.json
!/app/**/*.txt
# the colour shapes that come with the app (app/colour-shapes.js; tools/make_colour_samples.py makes them)
!/app/assets/models/*.glb
# the previews on the samples page (a few small ones are added every day; tools/make_sample_previews.mjs makes them)
!/app/guide/samples/*.jpg
!/app/guide/samples/*.mp4
# the annotated screenshots of the 使い方 page (tools/manual/shoot.mjs makes them)
!/app/guide/manual/*.jpg
/tools/**
!/tools/**/
!/tools/**/*.py
!/tools/**/*.mjs
!/tools/**/*.js
!/tools/**/*.html
/scripts/**
!/scripts/**/
!/scripts/**/*.py
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/*.json
!/docs/**/*.txt
!/app/_headers
**/.DS_Store
**/._*
**/__pycache__/
**/node_modules/
**/.env
**/.env.*
**/*.pem
**/*.key
/tools/out/

# Bundled, redistributable font binaries used offline by Troika.
!/app/vendor/motion-fonts/*.ttf

/tools/code-motion-font-build/.venv/
/tools/code-motion-build/.deps/
/tools/image-code-build/.deps/
/tools/image-code-build/.test-deps/
!/tools/image-code-build/package.json
!/tools/image-code-build/package-lock.json
!/tools/image-code-build/README.md

# Rendered previews made solely from the synthetic surface-effect test image.
!/app/assets/surface-previews/*.jpg

# Actual local renders of the eleven workshop collection examples.
!/app/assets/workshop-previews/*.jpg

# Isolated STUDIO dependencies (no node_modules or cache).
!/tools/studio-build/package.json
!/tools/studio-build/package-lock.json
